{
  "algorithm": "dpo",
  "model_config": {
    "vocab_size": 50304,
    "d_model": 384,
    "d_ff": 1024,
    "num_layers": 16,
    "num_experts": 16,
    "num_heads": 16,
    "block_size": 2048,
    "dropout": 0.1
  },
  "preference_data_config": {
    "output_dir": "./rlhf_data",
    "val_examples_per_dataset": 25,
    "dataset_mix": {
      "alpaca": 0,
      "dolly": 0,
      "evol_instruct": 8000,
      "everyday_conversations": 1000,
      "gsm8k": 3000,
      "code_python": 5000,
      "orca_math": 2500,
      "smollm_basics": 400,
      "smoltalk_10k": 3000
    }
  },
  "data_config": {
    "train_file": "./rlhf_data/train_preferences.jsonl",
    "val_file": "./rlhf_data/val_preferences.jsonl",
    "max_prompt_length": 768,
    "max_response_length": 256
  },
  "dpo_config": {
    "epochs": 1,
    "batch_size": 2,
    "gradient_accumulation_steps": 4,
    "learning_rate": 5e-7,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "beta": 0.1,
    "length_normalize": true,
    "aux_loss_weight": 1e-3,
    "save_interval": 200,
    "log_interval": 20
  },
  "checkpoint_config": {
    "sft_checkpoint_path": "./sft_checkpoints/sft_ckpt_full_final.pt",
    "policy_output_dir": "./rlhf_checkpoints",
    "resume_policy_from": null
  },
  "runtime_config": {
    "seed": 42,
    "mixed_precision": "bf16",
    "device": "cuda"
  }
}
